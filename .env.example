# CitySearch — Environment Configuration
# Copy this file to .env or .env.local to customize endpoints or provide optional API keys.

# ==============================================================================
# Geocoding & Places Provider Configuration
# ==============================================================================
# CitySearch works out of the box with OpenStreetMap (Nominatim & Overpass API)
# without any API keys required.

# Preferred geocoding provider: 'nominatim' (default) or 'geoapify'
VITE_GEOCODING_PROVIDER=nominatim

# Optional: Geoapify API Key (from https://www.geoapify.com)
# When provided, Geoapify can be used for geocoding and as an additional POI source.
VITE_GEOAPIFY_API_KEY=

# Optional: Custom Overpass API interpreter mirror
# Default: https://z.overpass-api.de/api/interpreter with automatic failover
VITE_OVERPASS_API_URL=https://z.overpass-api.de/api/interpreter

# ==============================================================================
# Optional Supabase Integration (for cloud-saved places across devices)
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
